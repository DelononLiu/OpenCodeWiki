{
  "name": "opencodewiki",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bash scripts/start.sh --watch",
    "dev:all": "bash scripts/start.sh --watch & cd src/python-agent && source .venv/bin/activate && uvicorn main:app --port 8000 --reload",
    "dev:agent": "cd src/python-agent && source .venv/bin/activate && uvicorn main:app --port 8000 --reload",
    "kill": "fuser -k 4747/tcp 8000/tcp 2>/dev/null; echo 'stopped'",
    "start": "bash scripts/start.sh",
    "build": "npx tsc",
    "wiki": "npx tsx scripts/wiki.mjs",
    "index": "node scripts/index.mjs",
    "reindex": "node scripts/reindex.mjs",
    "watch": "node scripts/reindex.mjs --watch",
    "postinstall": "node scripts/postinstall.mjs",
    "setup": "npm install --ignore-scripts && node scripts/postinstall.mjs",
    "wiki:entity": "cd src/python-agent && source .venv/bin/activate && python3 -c \"import json, os; from wiki_entity_builder import generate_skeleton; c='$*'.split(); r=generate_skeleton(c[0],' '.join(c[1:])); os.makedirs(os.path.dirname('$HOME/.opencodewiki/entities/x'),exist_ok=True); json.dump(r,open(os.path.expanduser('$HOME/.opencodewiki/entities/'+r['slug']+'.json'),'w'),ensure_ascii=False,indent=2); print(r['slug']+' written')\"",
    "wiki:entity:list": "ls ~/.opencodewiki/entities/ 2>/dev/null || echo '(no entities)'",
    "eval:qa": "EMBED_ENGINE=local LD_LIBRARY_PATH=node_modules/sharp/vendor/8.14.5/lib:$LD_LIBRARY_PATH node eval/runner.mjs",
    "eval:report": "node eval/report.mjs",
    "eval:answer": "bash eval/eval.sh"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "^0.22.1",
    "@huggingface/tokenizers": "^0.1.3",
    "@xenova/transformers": "^2.17.2",
    "cors": "^2.8.5",
    "express": "^4.21.0",
    "express-session": "^1.19.0",
    "onnxruntime-web": "^1.26.0",
    "openid-client": "^5.7.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/express-session": "^1.19.0",
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0"
  }
}
